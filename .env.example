# LLM provider:
#   gemini | openai | anthropic | ollama | openrouter | openai_compatible
LLM_PROVIDER=gemini

# Gemini (langchain-google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (langchain-openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (langchain-anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama local — no cloud API key. Prefer a vision model (qwen2.5vl, llama3.2-vision).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b

# OpenRouter (OpenAI-compatible; hosts open + closed models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-vl-7b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generic OpenAI-compatible endpoint (Groq, Together, Fireworks, vLLM, LM Studio)
# LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Persistent Chromium profile (cookies / LinkedIn session)
CHROME_USER_DATA_DIR=

# Optional: headless browser (true|false)
BROWSER_HEADLESS=false

# Optional: max agent steps
BROWSER_MAX_STEPS=70

# Cost control (USD limit per execution)
LLM_COST_LIMIT=5.0
USE_CHEAP_FALLBACK=true

# Rate limiting (seconds between requests to same domain)
DOMAIN_MIN_DELAY=3.0
